{
  "family": "application-service",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::477972658830:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::477972658830:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "application-service",
      "image": "477972658830.dkr.ecr.us-east-2.amazonaws.com/application-service:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "SPRING_PROFILES_ACTIVE",
          "value": "prod"
        },
        {
          "name": "SPRING_DATASOURCE_URL",
          "value": "jdbc:postgresql://application-db.c76gues0mrua.us-east-2.rds.amazonaws.com:5432/interntrack"
        },
        {
          "name": "SPRING_DATASOURCE_USERNAME",
          "value": "interntrack"
        },
        {
          "name": "SPRING_JPA_HIBERNATE_DDL_AUTO",
          "value": "none"
        },
        {
          "name": "SPRING_FLYWAY_ENABLED",
          "value": "true"
        },
        {
          "name": "SPRING_FLYWAY_BASELINE_ON_MIGRATE",
          "value": "true"
        }
      ],
      "secrets": [
        {
          "name": "SPRING_DATASOURCE_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:us-east-2:477972658830:secret:application-service/db-password-cWinCg"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/application-service",
          "awslogs-region": "us-east-2",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:8080/actuator/health || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      }
    }
  ]
}

